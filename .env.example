# Foundry project endpoint (Foundry portal > project > Overview > Endpoint)
PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# Chat model deployment name
MODEL_DEPLOYMENT=gpt-5-mini
# Azure OpenAI endpoint of the same Foundry resource, used for embeddings
AOAI_ENDPOINT=https://<resource>.openai.azure.com
# Embedding deployment name. The shipped index was built with this model; changing it means rebuilding the index.
EMBEDDING_DEPLOYMENT=text-embedding-3-small
